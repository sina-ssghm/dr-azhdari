{
  "name": "dr-azhdari-website",
  "version": "0.1.0",
  "private": true,
  "description": "Official website for Dr. Zohre Azhdari — psychotherapy, hypnotherapy and counselling.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "screenshot": "node scripts/screenshot.mjs",
    "photo": "node scripts/set-photo.mjs",
    "flags": "node scripts/copy-flags.mjs",
    "hero-shot": "node scripts/hero-shot.mjs",
    "check-reveal": "node scripts/check-reveal.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-admin.mjs",
    "e2e:uploader": "node --env-file-if-exists=.env scripts/e2e-uploader.mjs",
    "e2e:tests": "node --env-file-if-exists=.env scripts/e2e-tests.mjs",
    "e2e:slider": "node scripts/e2e-slider.mjs",
    "e2e:comments": "node --env-file-if-exists=.env scripts/e2e-comments.mjs",
    "e2e:articles": "node --env-file-if-exists=.env scripts/e2e-articles.mjs",
    "build:tests": "python scripts/build-tests.py docs/tests-source.txt"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.11",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "country-flag-icons": "^1.6.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
