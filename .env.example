# Copy to `.env` (docker compose reads it automatically) and fill in.

# Public origin of the site, no trailing slash.
# Baked into the client bundle at BUILD time — rebuild the image after changing.
NEXT_PUBLIC_SITE_URL=https://example.ir

# Host port the container is published on.
HOST_PORT=3100

# PostgreSQL runs OUTSIDE Docker.
#   from inside the container -> host.docker.internal
#   from the host (psql, migrations, seeding) -> localhost
# Read at runtime; no rebuild needed after changing it.
# Percent-encode the password if it contains @ : / # or ? — an unencoded @
# splits the URL early and you get a confusing "host not found".
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/dr_azhdari

# Signs the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -hex 32
# Rotating this immediately signs out every admin session.
SESSION_SECRET=

# Where uploaded payment receipts are written. Must stay OUTSIDE public/ —
# it is served only through the admin-authenticated /admin/receipts route.
# The default matches the volume in docker-compose.yml; when running with
# `npm run dev` on Windows, point it somewhere local instead, e.g. ./data/receipts
RECEIPT_DIR=/data/receipts

# Only read by `npm run db:seed`, never by the app.
ADMIN_USERNAME=09392738157
ADMIN_PASSWORD=
